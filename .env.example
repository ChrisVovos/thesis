# Copy this file to `.env` and fill in real values. `.env` is git-ignored on purpose:
# no credential belongs in version control, not even for a local stack.

# The SQL Server system administrator password. Must satisfy the SQL Server complexity policy.
MSSQL_SA_PASSWORD=

# The symmetric signing key for the access tokens. At least 64 characters; generate a random one, for
# example with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=

# The bootstrap administrator account created on first start.
SEED_ADMIN_EMAIL=administrator@itemauthoring.local
SEED_ADMIN_PASSWORD=

# The size of the generated sample item bank. Larger banks make the paging comparison more
# interesting and the first start slower.
SEED_SAMPLE_ITEMS=2000

# `Benchmark` keeps the transport selector and the measurement endpoints available.
# Use `Production` for a deployment that must not expose the experiment tooling.
API_ENVIRONMENT=Benchmark
